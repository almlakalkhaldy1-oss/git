stages:
  - test
  - ai_analysis
  - report

variables:
  AI_PROVIDER: ${AI_PROVIDER:-openai}
  AI_TIMEOUT: 30
  LOG_FILE: "ai_analysis_log.txt"

# ============================================
# AI Analysis Job - يدعم عدة نماذج
# ============================================
ai_analysis:
  stage: ai_analysis
  image: curlimages/curl:latest
  script:
    - echo "🤖 بدء تحليل الذكاء الاصطناعي..."
    - echo "AI Provider: $AI_PROVIDER" | tee $LOG_FILE
    - |
      case "$AI_PROVIDER" in
        openai)
          echo "📤 استدعاء OpenAI API..."
          curl -X POST https://api.openai.com/v1/chat/completions \
            -H "Authorization: Bearer $OPENAI_API_KEY" \
            -H "Content-Type: application/json" \
            -d '{
              "model": "'${OPENAI_MODEL:-gpt-3.5-turbo}'",
              "messages": [
                {
                  "role": "user",
                  "content": "حلل هذا المشروع وقدم ملخصاً عن الكود والميزات الرئيسية."
                }
              ],
              "max_tokens": 500
            }' \
            --max-time $AI_TIMEOUT \
            --retry 3 \
            -o response.json || echo "❌ فشل استدعاء OpenAI"
          cat response.json | tee -a $LOG_FILE
          ;;
        gemini)
          echo "📤 استدعاء Google Gemini API..."
          curl -X POST "https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key=$GEMINI_API_KEY" \
            -H "Content-Type: application/json" \
            -d '{
              "contents": [{
                "parts": [{
                  "text": "حلل هذا المشروع وقدم ملخصاً عن الكود والميزات الرئيسية."
                }]
              }]
            }' \
            --max-time $AI_TIMEOUT \
            --retry 3 \
            -o response.json || echo "❌ فشل استدعاء Gemini"
          cat response.json | tee -a $LOG_FILE
          ;;
        claude)
          echo "📤 استدعاء Claude API..."
          curl -X POST https://api.anthropic.com/v1/messages \
            -H "x-api-key: $CLAUDE_API_KEY" \
            -H "anthropic-version: 2023-06-01" \
            -H "Content-Type: application/json" \
            -d '{
              "model": "'${CLAUDE_MODEL:-claude-3-sonnet-20240229}'",
              "max_tokens": 500,
              "messages": [
                {
                  "role": "user",
                  "content": "حلل هذا المشروع وقدم ملخصاً عن الكود والميزات الرئيسية."
                }
              ]
            }' \
            --max-time $AI_TIMEOUT \
            --retry 3 \
            -o response.json || echo "❌ فشل استدعاء Claude"
          cat response.json | tee -a $LOG_FILE
          ;;
        huggingface)
          echo "📤 استدعاء Hugging Face API..."
          curl -X POST https://api-inference.huggingface.co/models/${HUGGINGFACE_MODEL:-mistralai/Mistral-7B-Instruct-v0.1} \
            -H "Authorization: Bearer $HUGGINGFACE_API_KEY" \
            -H "Content-Type: application/json" \
            -d '{
              "inputs": "حلل هذا المشروع وقدم ملخصاً عن الكود والميزات الرئيسية.",
              "parameters": {
                "max_length": 500
              }
            }' \
            --max-time $AI_TIMEOUT \
            --retry 3 \
            -o response.json || echo "❌ فشل استدعاء Hugging Face"
          cat response.json | tee -a $LOG_FILE
          ;;
        ollama)
          echo "📤 استدعاء Ollama (محلي)..."
          curl -X POST http://${OLLAMA_HOST:-localhost:11434}/api/generate \
            -H "Content-Type: application/json" \
            -d '{
              "model": "'${OLLAMA_MODEL:-mistral}'",
              "prompt": "حلل هذا المشروع وقدم ملخصاً عن الكود والميزات الرئيسية.",
              "stream": false
            }' \
            --max-time $AI_TIMEOUT \
            --retry 3 \
            -o response.json || echo "❌ فشل استدعاء Ollama"
          cat response.json | tee -a $LOG_FILE
          ;;
        *)
          echo "❌ AI Provider غير معروف: $AI_PROVIDER"
          exit 1
          ;;
      esac
    - echo "✅ اكتمل استدعاء API"
  artifacts:
    paths:
      - response.json
      - $LOG_FILE
    expire_in: 30 days
  retry:
    max: 2
    when:
      - api_failure
      - runner_system_failure
  allow_failure: true
  only:
    - merge_requests
    - main

# ============================================
# Advanced AI Analysis with Python
# ============================================
ai_analysis_advanced:
  stage: ai_analysis
  image: python:3.11
  script:
    - echo "🐍 تثبيت المكتبات المطلوبة..."
    - pip install requests python-dotenv pyyaml
    - |
      cat > ai_caller.py << 'EOF'
      import os
      import json
      import requests
      from datetime import datetime
      
      class AICaller:
          def __init__(self, provider):
              self.provider = provider
              self.timeout = int(os.getenv('AI_TIMEOUT', 30))
              self.log_file = os.getenv('LOG_FILE', 'ai_analysis_log.txt')
              
          def log(self, message):
              timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
              log_message = f"[{timestamp}] {message}"
              print(log_message)
              with open(self.log_file, 'a') as f:
                  f.write(log_message + "\n")
          
          def call_openai(self):
              self.log("📤 استدعاء OpenAI API...")
              api_key = os.getenv('OPENAI_API_KEY')
              model = os.getenv('OPENAI_MODEL', 'gpt-3.5-turbo')
              
              headers = {
                  'Authorization': f'Bearer {api_key}',
                  'Content-Type': 'application/json'
              }
              data = {
                  'model': model,
                  'messages': [{
                      'role': 'user',
                      'content': 'حلل هذا المشروع وقدم توصيات تحسين الأداء.'
                  }],
                  'max_tokens': 500
              }
              try:
                  response = requests.post(
                      'https://api.openai.com/v1/chat/completions',
                      headers=headers,
                      json=data,
                      timeout=self.timeout
                  )
                  response.raise_for_status()
                  return response.json()
              except Exception as e:
                  self.log(f"❌ خطأ: {str(e)}")
                  return None
          
          def call_gemini(self):
              self.log("📤 استدعاء Google Gemini API...")
              api_key = os.getenv('GEMINI_API_KEY')
              
              url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key={api_key}"
              data = {
                  'contents': [{
                      'parts': [{
                          'text': 'حلل هذا المشروع وقدم توصيات تحسين الأداء.'
                      }]
                  }]
              }
              try:
                  response = requests.post(
                      url,
                      json=data,
                      timeout=self.timeout
                  )
                  response.raise_for_status()
                  return response.json()
              except Exception as e:
                  self.log(f"❌ خطأ: {str(e)}")
                  return None
          
          def call_claude(self):
              self.log("📤 استدعاء Claude API...")
              api_key = os.getenv('CLAUDE_API_KEY')
              model = os.getenv('CLAUDE_MODEL', 'claude-3-sonnet-20240229')
              
              headers = {
                  'x-api-key': api_key,
                  'anthropic-version': '2023-06-01',
                  'Content-Type': 'application/json'
              }
              data = {
                  'model': model,
                  'max_tokens': 500,
                  'messages': [{
                      'role': 'user',
                      'content': 'حلل هذا المشروع وقدم توصيات تحسين الأداء.'
                  }]
              }
              try:
                  response = requests.post(
                      'https://api.anthropic.com/v1/messages',
                      headers=headers,
                      json=data,
                      timeout=self.timeout
                  )
                  response.raise_for_status()
                  return response.json()
              except Exception as e:
                  self.log(f"❌ خطأ: {str(e)}")
                  return None
          
          def execute(self):
              provider = self.provider.lower()
              
              if provider == 'openai':
                  result = self.call_openai()
              elif provider == 'gemini':
                  result = self.call_gemini()
              elif provider == 'claude':
                  result = self.call_claude()
              else:
                  self.log(f"❌ Provider غير مدعوم: {provider}")
                  return None
              
              if result:
                  with open('response.json', 'w') as f:
                      json.dump(result, f, indent=2)
                  self.log("✅ تم حفظ النتيجة بنجاح")
              
              return result
      
      if __name__ == '__main__':
          provider = os.getenv('AI_PROVIDER', 'openai')
          caller = AICaller(provider)
          caller.execute()
      EOF
    - python ai_caller.py
  artifacts:
    paths:
      - response.json
      - $LOG_FILE
    expire_in: 30 days
  allow_failure: true
  only:
    - merge_requests
    - main

# ============================================
# Generate Report
# ============================================
generate_report:
  stage: report
  image: python:3.11
  script:
    - echo "📊 توليد التقرير..."
    - |
      cat > generate_report.py << 'EOF'
      import json
      import os
      from datetime import datetime
      
      report = f"""
      ╔════════════════════════════════════════════════════════╗
      ║         تقرير تحليل الذكاء الاصطناعي                    ║
      ║                  AI Analysis Report                    ║
      ╚════════════════════════════════════════════════════════╝
      
      📅 التاريخ والوقت: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
      🔗 Git Commit: {os.environ.get('CI_COMMIT_SHA', 'N/A')}
      🌿 الفرع: {os.environ.get('CI_COMMIT_BRANCH', 'N/A')}
      
      """
      
      try:
          with open('response.json', 'r') as f:
              data = json.load(f)
              report += f"\n📋 نتيجة التحليل:\n{json.dumps(data, indent=2, ensure_ascii=False)}\n"
      except Exception as e:
          report += f"\n⚠️ لا يمكن قراءة النتيجة: {str(e)}\n"
      
      report += "\n" + "="*60 + "\n"
      
      with open('AI_REPORT.txt', 'w', encoding='utf-8') as f:
          f.write(report)
      
      print(report)
      EOF
    - python generate_report.py
  artifacts:
    paths:
      - AI_REPORT.txt
      - $LOG_FILE
    expire_in: 90 days
  dependencies:
    - ai_analysis
    - ai_analysis_advanced
  allow_failure: true

# ============================================
# التعريفات والتكوين
# ============================================
# GitLab CI/CD Variables يجب تعريفها:
#
# OpenAI:
#   - OPENAI_API_KEY: مفتاح API من OpenAI
#   - OPENAI_MODEL: نموذج GPT (مثل: gpt-3.5-turbo, gpt-4)
#
# Google Gemini:
#   - GEMINI_API_KEY: مفتاح API من Google
#
# Claude:
#   - CLAUDE_API_KEY: مفتاح API من Anthropic
#   - CLAUDE_MODEL: نموذج Claude (مثل: claude-3-sonnet-20240229)
#
# Hugging Face:
#   - HUGGINGFACE_API_KEY: مفتاح API من Hugging Face
#   - HUGGINGFACE_MODEL: اسم النموذج (مثل: mistralai/Mistral-7B)
#
# Ollama (محلي):
#   - OLLAMA_HOST: عنوان الخادم (مثل: localhost:11434)
#   - OLLAMA_MODEL: اسم النموذج (مثل: mistral, llama2)
